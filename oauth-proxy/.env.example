# 复制本文件为 .env 后填写真实值( .env 不要提交到 Git )
# 宝塔:文件管理 → /www/wwwroot/cube007-oauth/ → 新建文件 .env

OAUTH_CLIENT_ID=你的GitHub_OAuth_Client_ID
OAUTH_CLIENT_SECRET=你的GitHub_OAuth_Client_Secret
OAUTH_ALLOWED_USERS=xCube007
OAUTH_PORT=8787
OAUTH_HOST=127.0.0.1
OAUTH_ORIGIN=https://cube007.cn,https://www.cube007.cn
