---
import '../../styles/global.css';
import CommandPalette from './CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  /** false 时去掉页头页脚,给全屏幻灯片用 */
  chrome?: boolean;
}

const { title, description, chrome = true } = Astro.props;
const siteName = 'Cube007';
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · 笔记与工具`;
const desc = description ?? 'Cube007 的个人网站 —— 编程 / 后端 / AI 学习笔记,附开发小工具。';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/favicon.svg', Astro.site).toString();
const path = Astro.url.pathname;

function navActive(href: string): boolean {
  if (href === '/') return path === '/' || path.startsWith('/notes/');
  return path === href || path.startsWith(href);
}

const navItems = [
  { href: '/', label: '笔记' },
  { href: '/tags/', label: '标签' },
  { href: '/tools/', label: '工具' },
  { href: '/about/', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN" class:list={[!chrome && 'is-deck']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05060a" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Cube007 学习笔记"
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    {
      chrome && (
        <header class="site-header">
          <div class="site-header__inner">
            <a href="/" class="brand" aria-label={`${siteName} 首页`}>
              <span class="brand__mark" aria-hidden="true">
                <span>C</span>
              </span>
              <span class="brand__name">
                {siteName}
                <span class="brand__cursor" aria-hidden="true">_</span>
              </span>
            </a>
            <button
              type="button"
              class="nav-toggle"
              aria-expanded="false"
              aria-controls="site-nav"
            >
              菜单
            </button>
            <nav id="site-nav" class="nav">
              <div class="nav__links">
                {navItems.map((item) => (
                  <a href={item.href} aria-current={navActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))}
              </div>
              <a
                href="/search/"
                class="nav__search"
                data-open-palette
                aria-current={navActive('/search/') ? 'page' : undefined}
              >
                <span class="nav__search-icon" aria-hidden="true">⌕</span>
                <span class="nav__search-text">搜索笔记和工具</span>
                <kbd>/</kbd>
              </a>
              <a href="/rss.xml" class="nav__rss">RSS</a>
            </nav>
          </div>
        </header>
      )
    }

    <main id="main" class:list={['site-main', !chrome && 'site-main--deck']}>
      <slot />
    </main>

    {
      chrome && (
        <footer class="site-footer">
          <div class="site-footer__inner">
            <div class="site-footer__meta">
              <span class="site-footer__status" aria-hidden="true" />
              <span>© {new Date().getFullYear()} {siteName}</span>
              <span class="site-footer__dot">/</span>
              <span>static · zero backend · Astro</span>
            </div>
            <div class="site-footer__links">
              <a href="/tools/">工具</a>
              <a href="/search/">搜索</a>
              <a href="/rss.xml">RSS</a>
              <a href="https://github.com/xCube007/cube007.cn" target="_blank" rel="noreferrer">
                GitHub
              </a>
              <a href="/admin/" class="site-footer__admin" rel="nofollow">写作</a>
            </div>
          </div>
        </footer>
      )
    }

    <CommandPalette />

    <style>
      .skip-link {
        position: absolute;
        left: var(--sp-4);
        top: -3rem;
        z-index: 30;
        padding: var(--sp-2) var(--sp-3);
        background: var(--bg-1);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-sm);
        color: var(--text-0);
      }
      .skip-link:focus {
        top: var(--sp-3);
      }

      /* ---- 页头:毛玻璃 + 底边一条流动的光 ---- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg-0) 72%, transparent);
        backdrop-filter: blur(16px) saturate(1.4);
        -webkit-backdrop-filter: blur(16px) saturate(1.4);
      }
      .site-header::after {
        content: '';
        position: absolute;
        inset: auto 0 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          var(--accent),
          var(--accent-2),
          var(--accent-3),
          transparent
        );
        background-size: 200% auto;
        opacity: 0.55;
        animation: flow-border 8s linear infinite;
      }
      .site-header__inner {
        max-width: var(--wide-w);
        margin: 0 auto;
        padding: var(--sp-3) var(--sp-6);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        flex-wrap: wrap;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-3);
        color: var(--text-0);
      }
      .brand:hover {
        color: var(--text-0);
      }
      /* 旋转渐变方块,内层挖空只留 1.5px 的光边 */
      .brand__mark {
        position: relative;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: var(--flow-conic);
        animation: spin-border 6s linear infinite;
        box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 40%, transparent);
      }
      .brand__mark span {
        display: grid;
        place-items: center;
        width: calc(100% - 3px);
        height: calc(100% - 3px);
        border-radius: 7.5px;
        background: var(--bg-0);
        font-family: var(--font-mono);
        font-size: var(--fs-sm);
        font-weight: 700;
        color: var(--accent);
      }
      .brand__name {
        font-family: var(--font-mono);
        font-size: var(--fs-lg);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .brand__cursor {
        color: var(--accent);
        animation: pulse-dot 1.1s steps(1) infinite;
      }

      .nav-toggle {
        display: none;
        background: var(--bg-1);
        border: 1px solid var(--border);
        color: var(--text-1);
        font-size: var(--fs-sm);
        padding: var(--sp-1) var(--sp-3);
        border-radius: 999px;
        cursor: pointer;
      }
      .nav-toggle:hover {
        border-color: var(--accent);
        color: var(--text-0);
      }

      .nav {
        display: flex;
        align-items: center;
        gap: var(--sp-3);
      }
      .nav__links {
        display: flex;
        gap: 2px;
        padding: 3px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: color-mix(in srgb, var(--bg-1) 60%, transparent);
      }
      .nav__links a {
        padding: 0.35rem 0.95rem;
        border-radius: 999px;
        color: var(--text-1);
        font-size: var(--fs-sm);
        font-weight: 500;
        transition: color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
      }
      .nav__links a:hover {
        color: var(--text-0);
        background: var(--bg-2);
      }
      .nav__links a[aria-current='page'] {
        color: var(--text-0);
        background: color-mix(in srgb, var(--accent) 16%, var(--bg-2));
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent),
          0 0 16px color-mix(in srgb, var(--accent) 25%, transparent);
      }

      /* 假输入框:点开快捷搜索面板,没有 JS 时就是去 /search/ 的链接 */
      .nav__search {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        height: 2.1rem;
        min-width: 13rem;
        padding: 0 0.4rem 0 0.8rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: color-mix(in srgb, var(--bg-1) 60%, transparent);
        color: var(--text-2);
        font-size: var(--fs-sm);
        transition: border-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
      }
      .nav__search:hover,
      .nav__search[aria-current='page'] {
        color: var(--text-1);
        border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
        box-shadow: 0 0 16px color-mix(in srgb, var(--accent) 18%, transparent);
      }
      .nav__search-icon {
        font-size: var(--fs-base);
        line-height: 1;
      }
      .nav__search-text {
        flex: 1;
      }
      .nav__search kbd {
        font-size: 0.65rem;
        padding: 0.05rem 0.4rem;
      }
      .nav__rss {
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        letter-spacing: 0.06em;
        color: var(--text-2);
      }
      .nav__rss:hover {
        color: var(--accent-3);
      }

      .site-main {
        max-width: var(--wide-w);
        margin: 0 auto;
        padding: var(--sp-12) var(--sp-6);
        min-height: calc(100vh - 200px);
      }
      .site-main--deck {
        max-width: none;
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }
      :global(html.is-deck),
      :global(html.is-deck body) {
        height: 100%;
        overflow: hidden;
        background: #05070d;
        background-image: none;
      }
      :global(html.is-deck body::before) {
        display: none;
      }

      .site-footer {
        position: relative;
        margin-top: var(--sp-20);
      }
      .site-footer::before {
        content: '';
        position: absolute;
        inset: 0 0 auto;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
      }
      .site-footer__inner {
        max-width: var(--wide-w);
        margin: 0 auto;
        padding: var(--sp-6);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        flex-wrap: wrap;
        color: var(--text-2);
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
      }
      .site-footer__meta,
      .site-footer__links {
        display: flex;
        gap: var(--sp-3);
        flex-wrap: wrap;
        align-items: center;
      }
      .site-footer__status {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ok);
        box-shadow: 0 0 8px var(--ok);
      }
      .site-footer__links a {
        color: var(--text-2);
      }
      .site-footer__links a:hover {
        color: var(--accent);
      }
      .site-footer__dot {
        opacity: 0.4;
      }
      /* 写作后台入口:平时和页脚文字同色,不抢注意力,hover 才亮起来 */
      .site-footer__admin {
        color: inherit;
      }
      .site-footer__admin:hover {
        color: var(--accent-3);
      }

      @media (max-width: 860px) {
        .nav__search {
          min-width: 0;
        }
        .nav__search-text {
          display: none;
        }
      }

      @media (max-width: 680px) {
        .site-header__inner,
        .site-main,
        .site-footer__inner {
          padding-left: var(--sp-4);
          padding-right: var(--sp-4);
        }
        .site-main {
          padding-top: var(--sp-8);
        }
        .nav-toggle {
          display: inline-flex;
        }
        .nav {
          display: none;
          width: 100%;
          flex-direction: column;
          align-items: stretch;
          gap: var(--sp-3);
          padding-bottom: var(--sp-2);
        }
        .nav.is-open {
          display: flex;
        }
        .nav__links {
          justify-content: space-between;
        }
        .nav__links a {
          flex: 1;
          text-align: center;
        }
        .nav__search-text {
          display: inline;
        }
        .nav__search kbd {
          display: none;
        }
        .nav__rss {
          align-self: center;
        }
      }
    </style>

    <script>
      // 指针特效:一个 pointermove 监听喂两样东西
      //   1. [data-spotlight] 卡片的光标高光 --mx/--my
      //   2. [data-tilt] 卡片的 3D 倾斜 --rx/--ry
      // 变量只写在卡片自己身上 —— 写到 <html> 上会让整页每帧重算样式。
      // 只在有精确指针的设备上开,触屏没有 hover,开了纯属白跑。
      const canHover = matchMedia('(hover: hover) and (pointer: fine)');
      const prefersCalm = matchMedia('(prefers-reduced-motion: reduce)');

      if (canHover.matches && !prefersCalm.matches) {
        const MAX_TILT = 6;
        let frame = 0;
        let x = 0;
        let y = 0;
        let target: Element | null = null;
        let tilted: HTMLElement | null = null;

        const resetTilt = () => {
          tilted?.style.removeProperty('--rx');
          tilted?.style.removeProperty('--ry');
          tilted = null;
        };

        const flush = () => {
          frame = 0;

          const card = target?.closest<HTMLElement>('[data-spotlight]');
          if (card) {
            const box = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${((x - box.left) / box.width) * 100}%`);
            card.style.setProperty('--my', `${((y - box.top) / box.height) * 100}%`);
          }

          const tilt = target?.closest<HTMLElement>('[data-tilt]') ?? null;
          if (tilt !== tilted) resetTilt();
          if (tilt) {
            const box = tilt.getBoundingClientRect();
            const px = (x - box.left) / box.width - 0.5;
            const py = (y - box.top) / box.height - 0.5;
            tilt.style.setProperty('--rx', `${(-py * MAX_TILT).toFixed(2)}deg`);
            tilt.style.setProperty('--ry', `${(px * MAX_TILT).toFixed(2)}deg`);
            tilted = tilt;
          }
        };

        document.addEventListener(
          'pointermove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            target = e.target as Element | null;
            if (!frame) frame = requestAnimationFrame(flush);
          },
          { passive: true }
        );
        document.documentElement.addEventListener('pointerleave', resetTilt);
      }

      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.textContent = open ? '关闭' : '菜单';
      });
    </script>
  </body>
</html>
