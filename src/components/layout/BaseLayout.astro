---
import '../../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const siteName = 'Cube007';
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · 笔记与工具`;
const desc = description ?? 'Cube007 的个人网站 —— 编程 / 后端 / AI 学习笔记,附开发小工具。';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/favicon.svg', Astro.site).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07080c" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Cube007 学习笔记"
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="brand">
          <span class="brand__mark">▮</span>
          <span class="brand__name flow-text">{siteName}</span>
        </a>
        <nav class="nav">
          <a href="/">笔记</a>
          <a href="/tags">标签</a>
          <a href="/tools">工具</a>
          <a href="/search">搜索</a>
          <a href="/about">关于</a>
          <a href="/rss.xml" class="nav__rss">RSS</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>© {new Date().getFullYear()} {siteName}</span>
        <span class="site-footer__dot">·</span>
        <span>暗色流光 · Astro 驱动</span>
        <span class="site-footer__dot">·</span>
        <a href="/admin/" class="site-footer__admin" rel="nofollow">写作</a>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(7, 8, 12, 0.72);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .site-header__inner {
        max-width: var(--wide-w);
        margin: 0 auto;
        padding: var(--sp-4) var(--sp-6);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        font-weight: 700;
        font-size: var(--fs-lg);
        letter-spacing: -0.01em;
        color: var(--text-0);
      }
      .brand:hover {
        color: var(--text-0);
      }
      .brand__mark {
        color: var(--accent);
      }
      .brand__name {
        font-family: var(--font-mono);
      }
      .nav {
        display: flex;
        gap: var(--sp-5);
        flex-wrap: wrap;
        justify-content: flex-end;
        align-items: center;
      }
      .nav a {
        color: var(--text-1);
        font-size: var(--fs-sm);
        font-weight: 500;
        padding: var(--sp-1) 0;
        border-bottom: 2px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .nav a:hover {
        color: var(--text-0);
        border-bottom-color: var(--accent);
      }
      .nav__rss {
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        letter-spacing: 0.04em;
        padding: 0.2rem 0.5rem !important;
        border: 1px solid var(--border) !important;
        border-radius: 999px;
        border-bottom: 1px solid var(--border) !important;
        color: var(--text-2) !important;
      }
      .nav__rss:hover {
        color: var(--accent) !important;
        border-color: var(--accent) !important;
      }

      .site-main {
        max-width: var(--wide-w);
        margin: 0 auto;
        padding: var(--sp-12) var(--sp-6);
        min-height: calc(100vh - 200px);
      }

      .site-footer {
        border-top: 1px solid var(--border);
        margin-top: var(--sp-20);
      }
      .site-footer__inner {
        max-width: var(--wide-w);
        margin: 0 auto;
        padding: var(--sp-6);
        display: flex;
        gap: var(--sp-2);
        flex-wrap: wrap;
        color: var(--text-2);
        font-size: var(--fs-sm);
      }
      .site-footer__dot {
        opacity: 0.5;
      }
      /* 写作后台入口:平时和页脚文字同色,不抢注意力,hover 才亮起来 */
      .site-footer__admin {
        color: inherit;
      }
      .site-footer__admin:hover {
        color: var(--accent-3);
      }

      @media (max-width: 600px) {
        .site-header__inner,
        .site-main,
        .site-footer__inner {
          padding-left: var(--sp-4);
          padding-right: var(--sp-4);
        }
      }
    </style>

    <script>
      // 卡片光标高光:把鼠标位置写成 --mx / --my,由 CSS 的 --spotlight 消费。
      // 只在有精确指针的设备上开,触屏没有 hover,开了纯属白跑。
      const canHover = matchMedia('(hover: hover) and (pointer: fine)');
      const prefersCalm = matchMedia('(prefers-reduced-motion: reduce)');

      if (canHover.matches && !prefersCalm.matches) {
        let frame = 0;
        let pending: { card: HTMLElement; x: number; y: number } | null = null;

        const flush = () => {
          frame = 0;
          if (!pending) return;
          const { card, x, y } = pending;
          const box = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${((x - box.left) / box.width) * 100}%`);
          card.style.setProperty('--my', `${((y - box.top) / box.height) * 100}%`);
        };

        document.addEventListener(
          'pointermove',
          (e) => {
            const target = e.target as Element | null;
            const card = target?.closest<HTMLElement>('[data-spotlight]');
            if (!card) return;
            pending = { card, x: e.clientX, y: e.clientY };
            if (!frame) frame = requestAnimationFrame(flush);
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
