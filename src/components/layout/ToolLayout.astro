---
import BaseLayout from './BaseLayout.astro';
import { tools } from '../../lib/tools/registry';

interface Props {
  title: string;
  description: string;
  slug: string;
  /** 给 <title>/meta 用;默认与可见描述相同 */
  pageDescription?: string;
}

const { title, description, slug, pageDescription } = Astro.props;
const others = tools.filter((t) => t.slug !== slug);
---

<BaseLayout title={title} description={pageDescription ?? description}>
  <section class="page-head tool-head">
    <a href="/tools/" class="back-link">← cd ~/tools</a>
    <p class="eyebrow">Tool · {slug}</p>
    <h1 class="page-title tool-title">{title}</h1>
    <p class="page-sub">{description}</p>
  </section>
  <slot />
  {
    others.length > 0 && (
      <nav class="tool-more" aria-label="其他工具">
        <div class="section-head">
          <h2 class="section-title">其他工具</h2>
        </div>
        <div class="tool-more__list">
          {others.map((t) => (
            <a href={`/tools/${t.slug}/`}>{t.short}</a>
          ))}
        </div>
      </nav>
    )
  }
</BaseLayout>

<style>
  .tool-head {
    margin-bottom: var(--sp-8);
  }
  .tool-title {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
  }

  .tool-more {
    margin-top: var(--sp-12);
  }
  .tool-more__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .tool-more__list a {
    display: inline-flex;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-1) 70%, transparent);
    color: var(--text-1);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    transition: border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }
  .tool-more__list a:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 30%, transparent);
  }
</style>
