---
import BaseLayout from './BaseLayout.astro';
import { tools } from '../../lib/tools/registry';

interface Props {
  title: string;
  description: string;
  slug: string;
  /** 给 <title>/meta 用;默认与可见描述相同 */
  pageDescription?: string;
}

const { title, description, slug, pageDescription } = Astro.props;
const others = tools.filter((t) => t.slug !== slug);
---

<BaseLayout title={title} description={pageDescription ?? description}>
  <section class="tool-head">
    <a href="/tools/" class="tool-back">← 所有工具</a>
    <h1 class="tool-title">{title}</h1>
    <p class="tool-desc">{description}</p>
  </section>
  <slot />
  {
    others.length > 0 && (
      <nav class="tool-more" aria-label="其他工具">
        <div class="tool-more__title">其他工具</div>
        <div class="tool-more__list">
          {others.map((t) => (
            <a href={`/tools/${t.slug}/`}>{t.short}</a>
          ))}
        </div>
      </nav>
    )
  }
</BaseLayout>

<style>
  .tool-head {
    margin-bottom: var(--sp-8);
  }
  .tool-back {
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .tool-back:hover {
    color: var(--accent);
  }
  .tool-title {
    font-size: var(--fs-2xl);
    margin: var(--sp-4) 0 var(--sp-2);
    letter-spacing: -0.02em;
  }
  .tool-desc {
    color: var(--text-1);
    max-width: 40rem;
  }

  .tool-more {
    margin-top: var(--sp-12);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }
  .tool-more__title {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }
  .tool-more__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .tool-more__list a {
    display: inline-flex;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-1);
    color: var(--text-1);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }
  .tool-more__list a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
