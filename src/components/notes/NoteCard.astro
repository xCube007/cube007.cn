---
import type { CollectionEntry } from 'astro:content';
import { estimateReadingMinutes } from '../../lib/reading-time';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { title, date, tags, description, draft, format } = note.data;
const body = typeof note.body === 'string' ? note.body : '';
const minutes = estimateReadingMinutes([title, description ?? '', body].join('\n'));

const dateStr = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
})
  .format(date)
  .replaceAll('/', '.');
---

<a
  href={`/notes/${note.id}/`}
  class:list={['note-row', 'reveal', draft && 'note-row--draft']}
  data-spotlight
>
  <div class="note-row__meta">
    <time datetime={date.toISOString()}>{dateStr}</time>
    <span>{format === 'slides' ? 'SLIDES' : `${minutes} MIN`}</span>
  </div>
  <div class="note-row__body">
    <h3 class="note-row__title">
      {title}
      {draft && <span class="note-row__draft">草稿</span>}
    </h3>
    {description && <p class="note-row__desc">{description}</p>}
    {
      tags.length > 0 && (
        <ul class="note-row__tags">
          {tags.map((t) => <li>#{t}</li>)}
        </ul>
      )
    }
  </div>
  <span class="note-row__arrow" aria-hidden="true">→</span>
</a>

<style>
  .note-row {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    gap: var(--sp-5);
    align-items: start;
    padding: var(--sp-5) var(--sp-5);
    border-radius: var(--radius);
    color: var(--text-0);
    transition: background 0.12s ease, box-shadow 0.12s ease;
  }
  /* 行间分隔线 */
  .note-row::before {
    content: '';
    position: absolute;
    inset: auto var(--sp-5) 0;
    height: 1px;
    background: var(--border);
  }
  .note-row:hover {
    color: var(--text-0);
    background:
      var(--spotlight),
      color-mix(in srgb, var(--bg-1) 80%, transparent);
    box-shadow:
      inset 2px 0 0 var(--accent),
      inset 0 0 0 1px var(--border),
      -8px 0 24px -12px var(--accent);
  }
  .note-row:hover::before {
    opacity: 0;
  }
  .note-row--draft {
    opacity: 0.75;
  }

  .note-row__meta {
    display: grid;
    gap: var(--sp-1);
    padding-top: 0.3rem;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }
  .note-row__meta time {
    color: var(--text-1);
  }
  .note-row:hover .note-row__meta time {
    color: var(--accent);
  }

  .note-row__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
    font-size: var(--fs-xl);
    line-height: 1.35;
  }
  .note-row:hover .note-row__title {
    background: var(--flow);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .note-row__draft {
    color: var(--warn);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    font-weight: 500;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent);
    background: color-mix(in srgb, var(--warn) 10%, transparent);
  }
  .note-row__desc {
    max-width: 44rem;
    margin-bottom: var(--sp-3);
    color: var(--text-1);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }
  .note-row__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .note-row__tags li {
    color: var(--accent-2);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }

  .note-row__arrow {
    align-self: center;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    transition: transform 0.12s ease, color 0.12s ease;
  }
  .note-row:hover .note-row__arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .note-row {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
      padding: var(--sp-4);
    }
    .note-row::before {
      inset-inline: var(--sp-4);
    }
    .note-row__meta {
      display: flex;
      gap: var(--sp-3);
      padding-top: 0;
    }
    .note-row__arrow {
      display: none;
    }
  }
</style>
