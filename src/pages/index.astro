---
import BaseLayout from '../components/layout/BaseLayout.astro';
import NoteCard from '../components/notes/NoteCard.astro';
import { getVisibleNotes } from '../lib/notes';
import { tools, toolsSummary } from '../lib/tools/registry';

// 时间流:按日期倒序;开发环境含草稿,生产构建排除
const notes = await getVisibleNotes();
---

<BaseLayout>
  <section class="hero">
    <p class="hero__eyebrow">Notes &amp; Tools</p>
    <h1 class="hero__title">
      <span class="flow-text">Cube007</span> 的学习笔记
    </h1>
    <p class="hero__sub">
      记录后端与 AI 的学习过程,顺手放一些日常用得上的开发小工具。
    </p>
    <div class="hero__line"></div>
  </section>

  <section class="feed">
    <div class="section-head">
      <h2 class="section-title">最新笔记</h2>
      <a class="section-link" href="/tags/">按标签浏览 →</a>
    </div>
    {
      notes.length === 0 ? (
        <p class="empty">还没有笔记,稍后再来。</p>
      ) : (
        <div class="feed__grid">
          {notes.map((note) => <NoteCard note={note} />)}
        </div>
      )
    }
  </section>

  <section class="tools-teaser">
    <div class="section-head">
      <h2 class="section-title">开发小工具</h2>
      <a class="section-link" href="/tools/">全部工具 →</a>
    </div>
    <p class="tools-teaser__desc">
      {toolsSummary()} —— 纯浏览器运行,数据不上传。
    </p>
    <div class="tools-teaser__grid">
      {tools.map((t) => <a href={`/tools/${t.slug}/`}>{t.short}</a>)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: var(--sp-12);
    padding-top: var(--sp-8);
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }
  /* 前面一点会呼吸的指示灯,给标题一个起点 */
  .hero__eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-3);
    box-shadow: 0 0 8px var(--accent-3);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  .hero__title {
    font-size: var(--fs-3xl);
    margin-bottom: var(--sp-4);
  }
  .hero__sub {
    color: var(--text-1);
    font-size: var(--fs-lg);
    max-width: 40rem;
  }
  /* 流光点缀:hero 下的呼吸光带 */
  .hero__line {
    margin-top: var(--sp-8);
    height: 2px;
    width: 100%;
    background: var(--flow);
    background-size: 200% auto;
    border-radius: 2px;
    animation: flow-line 5s ease-in-out infinite;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .section-title {
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    color: var(--text-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  .section-link {
    color: var(--text-2);
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .section-link:hover {
    color: var(--accent);
  }

  .feed__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--sp-4);
  }

  .tools-teaser {
    position: relative;
    overflow: hidden;
    margin-top: var(--sp-12);
    padding: var(--sp-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(
        500px 160px at 100% 0%,
        color-mix(in srgb, var(--accent-2) 12%, transparent),
        transparent 60%
      ),
      var(--bg-1);
  }
  /* 顶边一道流光,把工具区和上面的笔记流分开 */
  .tools-teaser::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--flow);
    opacity: 0.6;
  }
  .tools-teaser .section-head {
    margin-bottom: var(--sp-3);
  }
  .tools-teaser__desc {
    color: var(--text-1);
    margin: 0 0 var(--sp-4);
    max-width: 44rem;
  }
  .tools-teaser__grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .tools-teaser__grid a {
    display: inline-flex;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-2);
    color: var(--text-1);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }
  .tools-teaser__grid a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .empty {
    color: var(--text-2);
  }
</style>
