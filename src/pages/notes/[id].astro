---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import TagChip from '../../components/notes/TagChip.astro';
import '../../styles/prose.css';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { estimateReadingMinutes } from '../../lib/reading-time';
import { extractToc } from '../../lib/toc';
import { findRelatedNotes } from '../../lib/related-notes';
import { isNoteVisible } from '../../lib/notes';
import { getDeckHtml } from '../../lib/decks';
import DeckMount from '../../components/notes/DeckMount.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', isNoteVisible)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );

  // 相关推荐只从已发布笔记里挑,避免草稿互相串
  const published = notes.filter((n) => !n.data.draft);

  return notes.map((note, i) => {
    const newer = i > 0 ? notes[i - 1] : null;
    const older = i < notes.length - 1 ? notes[i + 1] : null;
    const related = findRelatedNotes(
      {
        id: note.id,
        title: note.data.title,
        tags: note.data.tags,
        date: note.data.date,
        description: note.data.description,
      },
      published.map((n) => ({
        id: n.id,
        title: n.data.title,
        tags: n.data.tags,
        date: n.data.date,
        description: n.data.description,
      })),
      3
    );
    return {
      params: { id: note.id },
      props: {
        note,
        prev: older ? { id: older.id, title: older.data.title } : null,
        next: newer ? { id: newer.id, title: newer.data.title } : null,
        related,
      },
    };
  });
}

interface Props {
  note: CollectionEntry<'notes'>;
  prev: { id: string; title: string } | null;
  next: { id: string; title: string } | null;
  related: Array<{
    id: string;
    title: string;
    tags: string[];
    sharedTags: string[];
    score: number;
  }>;
}

const { note, prev, next, related } = Astro.props;
const { Content } = await render(note);
const { title, date, tags, description, draft } = note.data;
const isSlides = note.data.format === 'slides';
const deckHtml = isSlides ? getDeckHtml(note.id) : '';
const body = typeof note.body === 'string' ? note.body : '';
const toc = isSlides ? [] : extractToc(body);
const hasToc = toc.length > 1;

const dateStr = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const minutes = estimateReadingMinutes([title, description ?? '', body].join('\n'));
---

<BaseLayout title={title} description={description} chrome={!isSlides}>
  {
    isSlides ? (
      <DeckMount html={deckHtml} />
    ) : (
  <>
  <div class="read-progress" id="read-progress" hidden></div>
  <article class:list={['note', hasToc && 'note--toc']}>
    <header class="note__head">
      <a href="/" class="back-link">← cd ~/notes</a>
      {
        draft && (
          <p class="note__draft-banner" role="status">
            草稿 · 仅本地开发可见,生产构建不会发布
          </p>
        )
      }
      {tags.length > 0 && <p class="eyebrow">{tags.join(' / ')}</p>}
      <h1 class="note__title">{title}</h1>
      {description && <p class="note__lead">{description}</p>}
      <div class="note__meta">
        <time datetime={date.toISOString()}>{dateStr}</time>
        <span class="note__sep">/</span>
        <span>{minutes} 分钟阅读</span>
        <button type="button" class="note__copy" id="copy-link">复制链接</button>
        {
          tags.length > 0 && (
            <ul class="note__tags">
              {tags.map((t) => (
                <li>
                  <TagChip name={t} href={`/tags/${t}/`} size="sm" />
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="note__layout">
      {
        hasToc && (
          <aside class="note__aside">
            <nav class="note__toc" aria-label="目录">
              <div class="note__toc-title">目录</div>
              <ol>
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.id}`}>{item.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }

      <div class="note__main">
        <div class="note__body">
          <Content />
        </div>

        {
          related.length > 0 && (
            <section class="note__related" aria-label="相关笔记">
              <div class="section-head">
                <h2 class="section-title">相关笔记</h2>
              </div>
              <div class="note__related-grid">
                {related.map((r) => (
                  <a class="neon-card related-card" href={`/notes/${r.id}/`} data-spotlight>
                    <div class="related-card__shared">
                      {r.sharedTags.map((t) => `#${t}`).join(' · ')}
                    </div>
                    <div class="related-card__title">{r.title}</div>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <nav class="note__pager" aria-label="相邻笔记">
          {
            prev ? (
              <a class="neon-card pager__item" href={`/notes/${prev.id}/`} data-spotlight>
                <span class="pager__label">← 上一篇</span>
                <span class="pager__title">{prev.title}</span>
              </a>
            ) : (
              <span class="pager__item pager__item--empty" />
            )
          }
          {
            next ? (
              <a
                class="neon-card pager__item pager__item--next"
                href={`/notes/${next.id}/`}
                data-spotlight
              >
                <span class="pager__label">下一篇 →</span>
                <span class="pager__title">{next.title}</span>
              </a>
            ) : (
              <span class="pager__item pager__item--empty" />
            )
          }
        </nav>
      </div>
    </div>
  </article>
  </>
    )
  }
</BaseLayout>

<script define:vars={{ toc }}>
  // 给正文 h2 补 id,方便目录锚点跳转
  const headings = document.querySelectorAll('.note__body h2');
  headings.forEach((h, i) => {
    if (!h.id && toc[i]) h.id = toc[i].id;
  });
</script>

<script>
  import { enhanceCodeBlocks } from '../../components/notes/code-copy';
  const noteBody = document.querySelector('.note__body');
  if (noteBody) enhanceCodeBlocks(noteBody);

  const copyBtn = document.getElementById('copy-link');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      copyBtn.textContent = '已复制 ✓';
    } catch {
      copyBtn.textContent = '复制失败';
    }
    window.setTimeout(() => {
      copyBtn.textContent = '复制链接';
    }, 1500);
  });

  const bar = document.getElementById('read-progress');
  const article = document.querySelector('.note');
  if (bar && article) {
    bar.removeAttribute('hidden');
    const onScroll = () => {
      const total = article.scrollHeight - window.innerHeight;
      const scrolled = total <= 0 ? 1 : Math.min(1, Math.max(0, window.scrollY / total));
      bar.style.transform = `scaleX(${scrolled})`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // 目录高亮:正文 h2 滚过视口上沿附近时,点亮对应的目录项
  const tocLinks = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.note__toc a')].map((a) => [
      decodeURIComponent(a.hash.slice(1)),
      a,
    ])
  );
  if (tocLinks.size > 0) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          tocLinks.forEach((a) => a.classList.remove('is-active'));
          tocLinks.get(entry.target.id)?.classList.add('is-active');
        }
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    document.querySelectorAll('.note__body h2[id]').forEach((h) => spy.observe(h));
  }
</script>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    height: 3px;
    background: var(--flow);
    box-shadow: 0 0 12px var(--accent), 0 0 4px var(--accent-3);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  .note {
    max-width: var(--content-w);
    margin: 0 auto;
  }
  .note--toc {
    max-width: calc(var(--content-w) + 220px + var(--sp-12));
  }

  /* ---- 标题区:背后一团小极光 ---- */
  .note__head {
    position: relative;
    isolation: isolate;
    max-width: var(--content-w);
    margin-bottom: var(--sp-8);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--border);
  }
  .note__head::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: -8rem;
    left: -12rem;
    width: 36rem;
    height: 22rem;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent-2) 22%, transparent),
      transparent
    );
    filter: blur(30px);
    pointer-events: none;
  }
  .note__head::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 8rem;
    height: 1px;
    background: var(--flow);
    box-shadow: 0 0 10px var(--accent);
  }
  .note__draft-banner {
    display: inline-flex;
    margin-bottom: var(--sp-4);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent);
    background: color-mix(in srgb, var(--warn) 10%, transparent);
    color: var(--warn);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }
  .note__title {
    font-size: clamp(2rem, 4.5vw, 2.9rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-4);
  }
  .note__lead {
    color: var(--text-1);
    font-size: var(--fs-lg);
    line-height: 1.65;
    margin-bottom: var(--sp-5);
  }
  .note__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .note__sep { opacity: 0.5; }
  .note__copy {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-2);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }
  .note__copy:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .note__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-left: auto;
  }

  /* ---- 正文 + 目录 ---- */
  .note__layout {
    display: grid;
    gap: var(--sp-8);
  }
  .note--toc .note__layout {
    grid-template-columns: minmax(0, var(--content-w)) 220px;
    gap: var(--sp-12);
  }
  .note__main {
    min-width: 0;
  }
  .note__aside {
    order: 2;
  }
  .note__toc {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    padding-left: var(--sp-4);
    border-left: 1px solid var(--border);
  }
  .note__toc-title {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }
  .note__toc ol {
    list-style: none;
    display: grid;
    gap: var(--sp-1);
  }
  .note__toc a {
    position: relative;
    display: block;
    padding: var(--sp-1) 0;
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.5;
    transition: color 0.2s ease;
  }
  .note__toc a::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--sp-4) - 1px);
    top: 0.2rem;
    bottom: 0.2rem;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .note__toc a:hover {
    color: var(--text-0);
  }
  .note__toc a.is-active {
    color: var(--accent);
  }
  .note__toc a.is-active::before {
    opacity: 1;
  }

  /* 正文排版在 src/styles/prose.css —— 与后台预览面板共用 */

  .note__related {
    margin-top: var(--sp-12);
  }
  .note__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--sp-3);
  }
  .related-card {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-4);
  }
  .related-card__shared {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .related-card__title {
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .note__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-8);
  }
  .pager__item {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4) var(--sp-5);
    min-height: 4.5rem;
  }
  .pager__item--next { text-align: right; }
  .pager__item--empty {
    min-height: 0;
  }
  .pager__label {
    color: var(--text-2);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }
  .pager__item:hover .pager__label {
    color: var(--accent);
  }
  .pager__title {
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  @media (max-width: 1100px) {
    .note--toc {
      max-width: var(--content-w);
    }
    .note--toc .note__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-8);
    }
    .note__aside {
      order: 0;
    }
    .note__toc {
      position: static;
      max-height: none;
      padding: var(--sp-4) var(--sp-5);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--bg-1) 80%, transparent);
    }
    .note__toc a::before {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .note__head::before {
      left: -6rem;
      width: 24rem;
    }
    .note__pager { grid-template-columns: 1fr; }
    .pager__item--next { text-align: left; }
  }
</style>
