---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { estimateReadingMinutes } from '../../lib/reading-time';
import { extractToc } from '../../lib/toc';

export async function getStaticPaths() {
  const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
  );

  return notes.map((note, i) => {
    const newer = i > 0 ? notes[i - 1] : null;
    const older = i < notes.length - 1 ? notes[i + 1] : null;
    return {
      params: { id: note.id },
      props: {
        note,
        prev: older
          ? { id: older.id, title: older.data.title }
          : null,
        next: newer
          ? { id: newer.id, title: newer.data.title }
          : null,
      },
    };
  });
}

interface Props {
  note: CollectionEntry<'notes'>;
  prev: { id: string; title: string } | null;
  next: { id: string; title: string } | null;
}

const { note, prev, next } = Astro.props;
const { Content } = await render(note);
const { title, date, tags, description } = note.data;
const body = typeof note.body === 'string' ? note.body : '';
const toc = extractToc(body);

const dateStr = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const minutes = estimateReadingMinutes([title, description ?? '', body].join('\n'));
---

<BaseLayout title={title} description={description}>
  <article class="note">
    <a href="/" class="note__back">← 回笔记流</a>
    <h1 class="note__title">{title}</h1>
    {description && <p class="note__lead">{description}</p>}
    <div class="note__meta">
      <time datetime={date.toISOString()}>{dateStr}</time>
      <span class="note__sep">·</span>
      <span>{minutes} 分钟阅读</span>
      {
        tags.length > 0 && (
          <ul class="note__tags">
            {tags.map((t) => (
              <li>
                <a href={`/tags/${t}/`}>#{t}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      toc.length > 1 && (
        <nav class="note__toc" aria-label="目录">
          <div class="note__toc-title">目录</div>
          <ol>
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="note__body">
      <Content />
    </div>

    <nav class="note__pager" aria-label="相邻笔记">
      {
        prev ? (
          <a class="pager__item pager__item--prev" href={`/notes/${prev.id}/`}>
            <span class="pager__label">上一篇</span>
            <span class="pager__title">{prev.title}</span>
          </a>
        ) : (
          <span class="pager__item pager__item--empty" />
        )
      }
      {
        next ? (
          <a class="pager__item pager__item--next" href={`/notes/${next.id}/`}>
            <span class="pager__label">下一篇</span>
            <span class="pager__title">{next.title}</span>
          </a>
        ) : (
          <span class="pager__item pager__item--empty" />
        )
      }
    </nav>
  </article>
</BaseLayout>

<script define:vars={{ toc }}>
  // 给正文 h2 补 id,方便目录锚点跳转
  const headings = document.querySelectorAll('.note__body h2');
  headings.forEach((h, i) => {
    if (!h.id && toc[i]) h.id = toc[i].id;
  });
</script>

<script>
  import { enhanceCodeBlocks } from '../../components/notes/code-copy';
  enhanceCodeBlocks(document.querySelector('.note__body') ?? document);
</script>

<style>
  .note {
    max-width: var(--content-w);
    margin: 0 auto;
  }
  .note__back {
    display: inline-block;
    color: var(--text-2);
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-6);
  }
  .note__title {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin-bottom: var(--sp-3);
    letter-spacing: -0.02em;
  }
  .note__lead {
    color: var(--text-1);
    font-size: var(--fs-lg);
    margin-bottom: var(--sp-4);
    line-height: 1.55;
  }
  .note__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
    color: var(--text-2);
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--border);
  }
  .note__sep { opacity: 0.5; }
  .note__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-left: auto;
  }
  .note__tags a {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: rgba(109, 139, 255, 0.08);
    border: 1px solid rgba(109, 139, 255, 0.18);
  }
  .note__tags a:hover { border-color: var(--accent); }

  .note__toc {
    margin-bottom: var(--sp-8);
    padding: var(--sp-4) var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-1);
  }
  .note__toc-title {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }
  .note__toc ol {
    list-style: none;
    display: grid;
    gap: var(--sp-2);
  }
  .note__toc a {
    color: var(--text-1);
    font-size: var(--fs-sm);
  }
  .note__toc a:hover { color: var(--accent); }

  .note__body {
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .note__body :global(p) {
    margin-bottom: var(--sp-4);
    color: var(--text-0);
  }
  .note__body :global(h2) {
    font-size: var(--fs-xl);
    margin: var(--sp-10) 0 var(--sp-3);
    padding-top: var(--sp-2);
    scroll-margin-top: 5rem;
  }
  .note__body :global(h3) {
    font-size: var(--fs-lg);
    margin: var(--sp-6) 0 var(--sp-2);
  }
  .note__body :global(ul),
  .note__body :global(ol) {
    margin: 0 0 var(--sp-4) var(--sp-6);
    color: var(--text-0);
  }
  .note__body :global(li) { margin-bottom: var(--sp-2); }
  .note__body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: var(--sp-3) var(--sp-4);
    margin: var(--sp-4) 0;
    color: var(--text-1);
    background: linear-gradient(90deg, rgba(109, 139, 255, 0.08), transparent 70%);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .note__body :global(code) {
    background: var(--bg-2);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    color: var(--accent-3);
  }
  .note__body :global(pre) {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-4);
    overflow-x: auto;
    margin: 0;
  }
  .note__body :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text-0);
  }
  .note__body :global(.code-block) {
    position: relative;
    margin-bottom: var(--sp-4);
  }
  .note__body :global(.code-block__copy) {
    position: absolute;
    top: var(--sp-2);
    right: var(--sp-2);
    background: var(--bg-1);
    border: 1px solid var(--border);
    color: var(--text-1);
    font-size: var(--fs-xs);
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--radius-sm);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .note__body :global(.code-block:hover .code-block__copy),
  .note__body :global(.code-block__copy:focus) { opacity: 1; }
  .note__body :global(.code-block__copy:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .note__body :global(a) { text-underline-offset: 0.15em; }
  .note__body :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: var(--sp-8) 0;
  }
  .note__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--sp-4);
    font-size: var(--fs-sm);
  }
  .note__body :global(th),
  .note__body :global(td) {
    border: 1px solid var(--border);
    padding: var(--sp-2) var(--sp-3);
  }
  .note__body :global(th) {
    background: var(--bg-1);
    text-align: left;
  }

  .note__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-12);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }
  .pager__item {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-1);
    color: var(--text-0);
    transition: border-color 0.15s ease, transform 0.15s ease;
    min-height: 4.5rem;
  }
  .pager__item:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    color: var(--text-0);
  }
  .pager__item--next { text-align: right; }
  .pager__item--empty {
    border: 0;
    background: transparent;
    min-height: 0;
  }
  .pager__label {
    color: var(--text-2);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
  }
  .pager__title {
    font-size: var(--fs-sm);
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    .note__pager { grid-template-columns: 1fr; }
    .pager__item--next { text-align: left; }
  }
</style>
