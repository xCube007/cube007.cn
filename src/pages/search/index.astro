---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { SearchItem } from '../../lib/search';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const index: SearchItem[] = notes.map((note) => ({
  id: note.id,
  title: note.data.title,
  description: note.data.description ?? '',
  tags: note.data.tags,
  date: note.data.date.toISOString().slice(0, 10),
  href: `/notes/${note.id}/`,
}));
---

<BaseLayout title="搜索" description="搜索 Cube007 的学习笔记。">
  <section class="search-head">
    <h1 class="search-title">搜索笔记</h1>
    <p class="search-sub">按标题、摘要、标签过滤。纯前端,无服务端。</p>
    <label class="search-box">
      <span class="sr-only">搜索关键词</span>
      <input
        id="q"
        type="search"
        placeholder="例如: Git / 索引 / embedding"
        autocomplete="off"
        spellcheck="false"
      />
    </label>
    <p id="count" class="search-count" aria-live="polite"></p>
  </section>

  <div id="results" class="results"></div>

  <script id="search-index" type="application/json" set:html={JSON.stringify(index)} />
</BaseLayout>

<script>
  import { searchNotes, type SearchItem } from '../../lib/search';

  const raw = document.getElementById('search-index')?.textContent ?? '[]';
  const index = JSON.parse(raw) as SearchItem[];
  const input = document.getElementById('q') as HTMLInputElement;
  const results = document.getElementById('results') as HTMLDivElement;
  const count = document.getElementById('count') as HTMLParagraphElement;

  function escapeHtml(s: string): string {
    return s
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function render(items: SearchItem[]) {
    count.textContent =
      items.length === 0 ? '没有匹配结果' : `共 ${items.length} 条`;

    results.innerHTML = items
      .map(
        (item) => `
      <a class="result" href="${escapeHtml(item.href)}">
        <div class="result__date">${escapeHtml(item.date)}</div>
        <h2 class="result__title">${escapeHtml(item.title)}</h2>
        ${
          item.description
            ? `<p class="result__desc">${escapeHtml(item.description)}</p>`
            : ''
        }
        ${
          item.tags.length
            ? `<ul class="result__tags">${item.tags
                .map((t) => `<li>#${escapeHtml(t)}</li>`)
                .join('')}</ul>`
            : ''
        }
      </a>`
      )
      .join('');
  }

  function run() {
    render(searchNotes(index, input.value));
  }

  input.addEventListener('input', run);

  const params = new URLSearchParams(location.search);
  const initial = params.get('q');
  if (initial) input.value = initial;
  run();
</script>

<style>
  .search-head { margin-bottom: var(--sp-8); max-width: 42rem; }
  .search-title { font-size: var(--fs-2xl); margin-bottom: var(--sp-2); }
  .search-sub { color: var(--text-1); margin-bottom: var(--sp-6); }
  .search-box input {
    width: 100%;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-0);
    font-size: var(--fs-lg);
    padding: var(--sp-3) var(--sp-4);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .search-box input:focus {
    border-color: var(--accent);
    box-shadow: var(--focus-ring);
  }
  .search-count {
    margin-top: var(--sp-3);
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    min-height: 1.25rem;
  }

  .results {
    display: grid;
    gap: var(--sp-3);
  }
  .results :global(.result) {
    display: block;
    padding: var(--sp-5) var(--sp-6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-1);
    color: var(--text-0);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .results :global(.result:hover) {
    border-color: var(--accent);
    transform: translateY(-1px);
    color: var(--text-0);
  }
  .results :global(.result__date) {
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    margin-bottom: var(--sp-2);
  }
  .results :global(.result__title) {
    font-size: var(--fs-lg);
    margin-bottom: var(--sp-2);
  }
  .results :global(.result__desc) {
    color: var(--text-1);
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-3);
  }
  .results :global(.result__tags) {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .results :global(.result__tags li) {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
