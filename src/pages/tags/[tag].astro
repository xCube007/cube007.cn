---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import NoteCard from '../../components/notes/NoteCard.astro';
import { getVisibleNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getVisibleNotes();
  // 收集所有标签(去重)
  const tags = new Set<string>();
  for (const note of notes) {
    for (const tag of note.data.tags) tags.add(tag);
  }
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      notes: notes
        .filter((n) => n.data.tags.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, notes } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`标签「${tag}」下的所有笔记。`}>
  <section class="page-head">
    <a href="/tags/" class="back-link">← cd ~/tags</a>
    <p class="eyebrow">Tag</p>
    <h1 class="page-title title"><span class="flow-text">#{tag}</span></h1>
    <p class="page-sub">{notes.length} 篇笔记</p>
  </section>

  <div class="list">
    {notes.map((note) => <NoteCard note={note} />)}
  </div>
</BaseLayout>

<style>
  .title { font-family: var(--font-mono); }
  .list {
    max-width: 52rem;
    margin: 0 calc(-1 * var(--sp-5));
  }
  @media (max-width: 680px) {
    .list { margin: 0 calc(-1 * var(--sp-4)); }
  }
</style>
