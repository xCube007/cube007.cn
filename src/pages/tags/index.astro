---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import TagChip from '../../components/notes/TagChip.astro';
import { getVisibleNotes } from '../../lib/notes';

// 收集所有标签 + 每个标签的笔记数(开发环境含草稿)
const notes = await getVisibleNotes();
const tagCounts = new Map<string, number>();
for (const note of notes) {
  for (const tag of note.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="按标签浏览所有笔记。">
  <section class="page-head">
    <a href="/" class="back-link">← cd ~/notes</a>
    <p class="eyebrow">Tags</p>
    <h1 class="page-title"><span class="flow-text">标签</span></h1>
    <p class="page-sub">共 {tags.length} 个标签,{notes.length} 篇笔记。</p>
  </section>

  <ul class="tag-list">
    {
      tags.map(([tag, count]) => (
        <li class="reveal">
          <TagChip name={tag} count={count} href={`/tags/${tag}/`} />
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
</style>
