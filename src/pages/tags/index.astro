---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getVisibleNotes } from '../../lib/notes';

// 收集所有标签 + 每个标签的笔记数(开发环境含草稿)
const notes = await getVisibleNotes();
const tagCounts = new Map<string, number>();
for (const note of notes) {
  for (const tag of note.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="按标签浏览所有笔记。">
  <section class="head">
    <a href="/" class="back">← 回笔记流</a>
    <h1 class="title">标签</h1>
    <p class="sub">共 {tags.length} 个标签,{notes.length} 篇笔记。</p>
  </section>

  <ul class="tag-list">
    {
      tags.map(([tag, count]) => (
        <li>
          <a href={`/tags/${tag}/`} class="tag">
            <span class="tag__name">#{tag}</span>
            <span class="tag__count">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .head { margin-bottom: var(--sp-8); }
  .back { color: var(--text-2); font-size: var(--fs-sm); }
  .title { font-size: var(--fs-2xl); margin: var(--sp-4) 0 var(--sp-2); }
  .sub { color: var(--text-1); }

  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--radius-sm);
    background: var(--bg-1);
    border: 1px solid var(--border);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .tag:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .tag__count {
    color: var(--text-2);
    font-size: var(--fs-xs);
  }
</style>
