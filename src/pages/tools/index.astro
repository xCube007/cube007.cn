---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { tools } from '../../lib/tools/registry';
---

<BaseLayout title="工具" description="Cube007 的开发小工具集合。">
  <section class="hero">
    <p class="hero__eyebrow">Dev Tools</p>
    <h1 class="hero__title">开发小工具</h1>
    <p class="hero__sub">纯前端、零上传、打开即用。</p>
  </section>

  <div class="tools-grid">
    {
      tools.map((t) => (
        <a href={`/tools/${t.slug}/`} class="tool-card" data-spotlight>
          <h3 class="tool-card__name">{t.name}</h3>
          <p class="tool-card__desc">{t.desc}</p>
          <span class="tool-card__status">可用</span>
        </a>
      ))
    }
  </div>
</BaseLayout>

<style>
  .hero {
    margin-bottom: var(--sp-12);
  }
  .hero__eyebrow {
    color: var(--accent-2);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }
  .hero__title {
    font-size: var(--fs-3xl);
    margin-bottom: var(--sp-4);
  }
  .hero__sub {
    color: var(--text-1);
    font-size: var(--fs-lg);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--sp-4);
  }

  .tool-card {
    position: relative;
    padding: var(--sp-6);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(109, 139, 255, 0.04), transparent 40%),
      var(--bg-1);
    border: 1px solid var(--border);
    color: var(--text-0);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }
  .tool-card::after {
    content: '';
    position: absolute;
    inset: auto -20% -40% auto;
    width: 120px;
    height: 120px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent-3) 12%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  /* 光标高光,坐标由 BaseLayout 的 data-spotlight 脚本写入 */
  .tool-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--spotlight);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .tool-card:hover::before {
    opacity: 1;
  }
  .tool-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
    color: var(--text-0);
  }
  .tool-card__name {
    font-size: var(--fs-lg);
    margin-bottom: var(--sp-2);
  }
  .tool-card__desc {
    color: var(--text-1);
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-4);
  }
  .tool-card__status {
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    padding: var(--sp-1) var(--sp-2);
    border-radius: var(--radius-sm);
    color: var(--ok);
    background: color-mix(in srgb, var(--ok) 10%, transparent);
  }
</style>
